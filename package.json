{
  "name": "pocketledger",
  "private": true,
  "version": "0.1.0",
  "description": "Free, private, offline-first household expense tracker (PWA).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run ocr-assets",
    "dev": "vite",
    "prebuild": "npm run ocr-assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "npm run ocr-assets && vite build --mode e2e",
    "licenses": "node scripts/licenses.mjs",
    "icons": "python3 scripts/make_icons.py",
    "pretest": "npm run ocr-assets"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^30.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
